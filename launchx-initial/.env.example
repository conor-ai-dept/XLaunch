# ============================================
# LaunchX Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Supabase project URL
# Find this in your Supabase dashboard: Settings > API > Project URL
# For local Supabase: http://127.0.0.1:54321
SUPABASE_URL=http://127.0.0.1:54321

# Supabase service role key (has full database access, bypasses RLS)
# Find this in your Supabase dashboard: Settings > API > service_role key
# WARNING: Never expose this key in client-side code or commit it to git
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Port for the Express API server (default: 3000)
PORT=3000

# Base URL for the LaunchX API (used by the CLI package)
# For local development, point to your running API server
# For production: https://api.launchx.dev/api/v1
LAUNCHX_API_URL=http://localhost:3000/api/v1
